# Copy to .env.local and replace the example paths for a full local runtime.
PERSONA_NAVI_SKILLS_DIR=/absolute/path/to/younavi/skills
PERSONA_NAVI_SOUL_WORKSPACE_ROOT=/absolute/path/to/younavi/workspace

# Optional overrides
# PERSONA_NAVI_AGENT_CLI=/Applications/YouNavi.app/Contents/Resources/backend/agent-cli
# PERSONA_NAVI_MATERIAL_ROOT=/absolute/path/to/override/classic-interviews
# PERSONA_NAVI_BRIDGE_PORT=8766
# PERSONA_NAVI_RUN_ROOT=/absolute/path/to/private/persona-runs
